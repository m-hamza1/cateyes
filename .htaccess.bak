# Apache Configuration for Ecommerce System
# Enable URL Rewriting and Security Headers

# Enable Rewrite Engine
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /new-hostinger-bugfix/
    
    # Force HTTPS (Uncomment in production)
    # RewriteCond %{HTTPS} off
    # RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
    
    # Remove www (or add www, choose one)
    # RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
    # RewriteRule ^(.*)$ http://%1/$1 [R=301,L]
    
    # SEO Friendly URLs
    # Product details: product/product-slug
    RewriteRule ^product/([a-z0-9-]+)$ product.php?slug=$1 [L,QSA]
    
    # Category: category/category-slug
    RewriteRule ^category/([a-z0-9-]+)$ shop.php?category=$1 [L,QSA]
    
    # Brand: brand/brand-slug
    RewriteRule ^brand/([a-z0-9-]+)$ shop.php?brand=$1 [L,QSA]
    
    # Blog post: blog/post-slug
    RewriteRule ^blog/([a-z0-9-]+)$ post.php?slug=$1 [L,QSA]
    
    # Page: page/page-slug
    RewriteRule ^page/([a-z0-9-]+)$ page.php?slug=$1 [L,QSA]
    
    # Remove .php extension
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}\.php -f
    RewriteRule ^(.*)$ $1.php [L]
    
    # Block access to sensitive files
    RewriteRule ^(config|includes)/.*$ - [F,L]
    
    # Block access to debug/test/diagnostic scripts
    RewriteRule ^(describe_|check_|list_|get_|find_|test_|debug|diag|clear_|fix_|setup_|rebuild_|verify_|sync_|update_trigger|run_tests).*\.php$ - [F,L]
    
    # Block access to vendor directory
    RewriteRule ^vendor/.*$ - [F,L]
    
    # Block access to SQL files
    RewriteRule ^sql/.*$ - [F,L]
    
    # Block access to log files
    RewriteRule ^logs/.*$ - [F,L]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    # XSS Protection
    Header set X-XSS-Protection "1; mode=block"
    
    # Prevent clickjacking
    Header set X-Frame-Options "SAMEORIGIN"
    
    # Prevent MIME-type sniffing
    Header set X-Content-Type-Options "nosniff"
    
    # Referrer Policy
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    
    # HTTP Strict Transport Security (enable in production with HTTPS)
    # Header set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    
    # Permissions Policy - restrict browser features
    Header set Permissions-Policy "camera=(), microphone=(), geolocation=(self), payment=(self)"
    
    # Content Security Policy
    Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://js.stripe.com; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://cdnjs.cloudflare.com https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https:; frame-src https://js.stripe.com; connect-src 'self' https://api.stripe.com;"
    
    # Remove Server Information
    Header unset Server
    Header unset X-Powered-By
    Header always unset X-Powered-By
</IfModule>

# Disable Directory Browsing
Options -Indexes

# Default Documents
DirectoryIndex index.php index.html

# Protect .htaccess and other hidden files
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect configuration files
<FilesMatch "\.(ini|log|conf|sql|md|txt|json|lock|env|bak|old|orig|dist)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Protect composer and config files specifically
<FilesMatch "^(composer\.json|composer\.lock|hostinger-config\.php|hostinger-config\.example\.php|db-connection-test\.php|\.env)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# Enable GZIP Compression
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
    ExpiresActive On
    
    # Images
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif "access plus 1 year"
    ExpiresByType image/png "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon "access plus 1 year"
    
    # CSS and JavaScript
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"
    
    # Fonts
    ExpiresByType font/ttf "access plus 1 year"
    ExpiresByType font/otf "access plus 1 year"
    ExpiresByType font/woff "access plus 1 year"
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType application/font-woff "access plus 1 year"
    
    # Default
    ExpiresDefault "access plus 2 days"
</IfModule>

# PHP Settings (if allowed by server)
<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 10M
    php_value max_execution_time 300
    php_value max_input_time 300
    php_flag display_errors Off
    php_flag log_errors On
</IfModule>

# Error Pages
ErrorDocument 404 /new-hostinger-bugfix/404.php
ErrorDocument 403 /new-hostinger-bugfix/403.php
ErrorDocument 500 /new-hostinger-bugfix/500.php
